{"calendario.html":"<!doctype html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Calendário de Atendimentos</title>\n<meta name=\"robots\" content=\"noindex,nofollow\">\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap\">\n<style>\nhtml{color-scheme:light}\nbody{margin:0}\n[hidden]{display:none!important}\nimg{max-width:100%}\n:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}\n\n/* Layout: barra fixa com marca e abas; coluna única até 980px; painel com faixa de números, alertas e o dia de hoje */\n:root{\n  --bg:#F6F4F3; --surface:#FFFFFF; --surface-2:#FAF8F7; --ink:#241B1A; --muted:#6E6462; --line:#E6DFDD;\n  --accent:#C8102E; --accent-ink:#FFFFFF; --accent-soft:#FCE4E7;\n  --sun:#D99000; --sun-soft:#FCF0D4;\n  --ok:#2C7A31; --ok-soft:#E2F2E2; --warn:#A35F00; --warn-soft:#FCEBD1; --bad:#9F1D12; --bad-soft:#F8E1DE; --info:#2756A0; --info-soft:#E2EAF8; --neutral:#5E6669; --neutral-soft:#ECEEEE;\n  --shadow:0 1px 2px rgba(40,20,20,.06),0 6px 18px rgba(40,20,20,.06);\n  --f-display:\"Fredoka\",\"Nunito Sans\",system-ui,sans-serif;\n  --f-body:\"Nunito Sans\",system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;\n  --r:12px;\n}\n@media (prefers-color-scheme: dark){:root:not([data-theme=\"light\"]){\n  --bg:#171213; --surface:#211A1B; --surface-2:#2A2122; --ink:#F2ECEB; --muted:#B3A6A5; --line:#3A2F30;\n  --accent:#FF6B72; --accent-ink:#2A0507; --accent-soft:#3D1A1D;\n  --sun:#F2B640; --sun-soft:#3A2E12;\n  --ok:#7CCB80; --ok-soft:#1C3420; --warn:#F0AE55; --warn-soft:#3A2A12; --bad:#F2877C; --bad-soft:#3D1D1A; --info:#8DB2F0; --info-soft:#1C2A42; --neutral:#A9B2B5; --neutral-soft:#2C3336;\n  --shadow:0 1px 2px rgba(0,0,0,.3),0 6px 18px rgba(0,0,0,.25); color-scheme:dark }}\n:root[data-theme=\"dark\"]{\n  --bg:#171213; --surface:#211A1B; --surface-2:#2A2122; --ink:#F2ECEB; --muted:#B3A6A5; --line:#3A2F30;\n  --accent:#FF6B72; --accent-ink:#2A0507; --accent-soft:#3D1A1D;\n  --sun:#F2B640; --sun-soft:#3A2E12;\n  --ok:#7CCB80; --ok-soft:#1C3420; --warn:#F0AE55; --warn-soft:#3A2A12; --bad:#F2877C; --bad-soft:#3D1D1A; --info:#8DB2F0; --info-soft:#1C2A42; --neutral:#A9B2B5; --neutral-soft:#2C3336;\n  --shadow:0 1px 2px rgba(0,0,0,.3),0 6px 18px rgba(0,0,0,.25); color-scheme:dark }\n*{box-sizing:border-box}\nbody{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.45;font-variant-numeric:tabular-nums}\nbody::before{content:\"\";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--surface)}\nh1,h2,h3{font-family:var(--f-display);font-weight:600;margin:0;text-wrap:balance;letter-spacing:.005em}\nbutton,input,select,textarea{font:inherit;color:inherit}\na{color:var(--accent)}\n:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\n.wrap{max-width:980px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}\n.muted{color:var(--muted)}\n.label{font-size:12px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);font-weight:700}\n\n/* topo */\n.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--surface);border-bottom:1px solid var(--line)}\n.top .wrap{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;padding-block:10px}\n.brand{display:flex;align-items:center;gap:10px;margin-right:auto;min-width:0}\n.brand-mark{width:34px;height:34px;flex:none}\n.brand h1{font-size:19px;line-height:1.1}\n.brand small{display:block;font-size:12px;color:var(--muted);font-family:var(--f-body);font-weight:600}\n.me{display:flex;align-items:center;gap:8px;font-size:13px}\n.me b{font-weight:700}\n.tabs{display:flex;gap:4px;overflow-x:auto;width:100%;scrollbar-width:none}\n.tab{border:0;background:none;padding:8px 12px;border-radius:999px;font-weight:700;color:var(--muted);cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:6px}\n.tab[aria-selected=\"true\"]{background:var(--accent-soft);color:var(--accent)}\n.tab .badge{background:var(--sun);color:#fff;border-radius:999px;font-size:11px;padding:0 6px;min-width:18px;text-align:center}\n\nmain{padding-block:20px 48px}\n.view{display:grid;gap:20px}\n\n/* botões e campos */\n.btn{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:7px 14px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;text-decoration:none;color:var(--ink);font-size:14px;line-height:1.2}\n.btn:hover{border-color:var(--accent)}\n.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}\n.btn.danger{color:var(--bad);border-color:var(--bad-soft)}\n.btn.small{padding:5px 10px;font-size:13px}\n.btn.wa{color:#fff;background:#1F8A4C;border-color:#1F8A4C}\n.btn[disabled]{opacity:.5;cursor:not-allowed}\n.field{display:grid;gap:4px;min-width:0}\n.field span{font-size:13px;font-weight:700;color:var(--muted)}\n.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:9px 11px;min-width:0}\n.field textarea{min-height:76px;resize:vertical}\n.grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}\n.span-all{grid-column:1/-1}\n.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:18px}\n.panel h2{font-size:18px;margin-bottom:12px}\n.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}\n.note{font-size:13px;color:var(--muted)}\n.msg{padding:10px 14px;border-radius:10px;font-size:14px}\n.msg.err{background:var(--bad-soft);color:var(--bad)}\n.msg.ok{background:var(--ok-soft);color:var(--ok)}\n.msg.info{background:var(--info-soft);color:var(--info)}\n\n/* login */\n.gate{min-height:80vh;display:grid;place-items:center;padding-block:24px}\n.gate-card{width:100%;max-width:380px;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:28px 24px;box-shadow:var(--shadow);display:grid;gap:14px}\n.gate-card h1{font-size:24px}\n.gate-card .brand-mark{width:48px;height:48px}\n\n/* números */\n.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}\n.stat{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:12px 14px;display:grid;gap:2px;text-align:left;cursor:pointer}\n.stat b{font-family:var(--f-display);font-size:28px;font-weight:600;line-height:1}\n.stat.hl{border-color:var(--sun);background:var(--sun-soft)}\n@media (max-width:620px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}}\n\n/* alertas */\n.alerts{display:grid;gap:14px}\n.alert-group h3{font-size:15px;display:flex;align-items:center;gap:8px;margin-bottom:8px}\n.dot{width:10px;height:10px;border-radius:50%;flex:none}\n.empty{border:1.5px dashed var(--line);border-radius:var(--r);padding:22px;text-align:center;color:var(--muted);display:grid;gap:8px;justify-items:center}\n\n/* itens */\n.list{display:grid;gap:10px}\n.day-head{font-family:var(--f-display);font-size:16px;font-weight:600;margin:10px 0 2px;display:flex;gap:8px;align-items:baseline}\n.day-head small{font-family:var(--f-body);color:var(--muted);font-weight:600;font-size:13px}\n.item{display:grid;grid-template-columns:64px minmax(0,1fr);gap:12px;background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--info);border-radius:var(--r);padding:12px 14px}\n.item.st-confirmado{border-left-color:var(--ok)}\n.item.st-realizado{border-left-color:var(--neutral)}\n.item.st-faltou{border-left-color:var(--warn)}\n.item.st-cancelado{border-left-color:var(--bad);opacity:.8}\n.item-time{display:grid;align-content:start;gap:2px}\n.item-time b{font-family:var(--f-display);font-size:20px;font-weight:600;line-height:1}\n.item-time span{font-size:12px;color:var(--muted);font-weight:600}\n.item-top{display:flex;flex-wrap:wrap;gap:6px 8px;align-items:center}\n.item-top h3{font-size:16px}\n.turma{font-size:12px;font-weight:700;background:var(--sun-soft);color:var(--warn);border-radius:6px;padding:1px 7px}\n.item-sub{margin:3px 0 0;font-size:14px;overflow-wrap:anywhere}\n.acts{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;align-items:center}\n.acts select{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:5px 8px;font-size:13px;font-weight:700}\n.pill{font-size:12px;font-weight:700;border-radius:999px;padding:2px 9px}\n.p-agendado{background:var(--info-soft);color:var(--info)}\n.p-confirmado{background:var(--ok-soft);color:var(--ok)}\n.p-realizado{background:var(--neutral-soft);color:var(--neutral)}\n.p-faltou{background:var(--warn-soft);color:var(--warn)}\n.p-cancelado{background:var(--bad-soft);color:var(--bad)}\n.why{font-size:12px;font-weight:700;color:var(--warn)}\n@media (max-width:480px){.item{grid-template-columns:1fr}.item-time{grid-auto-flow:column;justify-content:start;align-items:baseline;gap:8px}}\n\n/* equipe */\n.people{display:grid;gap:8px}\n.person{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;border:1px solid var(--line);border-radius:10px;padding:10px 12px;background:var(--surface-2)}\n.person .who{margin-right:auto;min-width:0}\n.person .who b{display:block}\n.person .who span{font-size:13px;color:var(--muted);overflow-wrap:anywhere}\n.tag{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;padding:2px 7px;border-radius:6px;background:var(--accent-soft);color:var(--accent)}\n.tag.off{background:var(--neutral-soft);color:var(--neutral)}\n.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(18px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:999px;font-weight:700;font-size:14px;z-index:20;max-width:calc(100% - 32px)}\n@media (prefers-reduced-motion:no-preference){.item,.stat,.btn{transition:border-color .15s,background .15s}}\n\n\n/* logos */\n.brand img{display:block;flex:none}\n.logo-eus{width:46px;height:46px}\n.logo-ant{height:24px;width:auto}\n.logo-sep{width:1px;height:32px;background:var(--line);flex:none}\n.gate-logos{display:flex;align-items:center;gap:14px}\n.gate-logos .logo-eus{width:72px;height:72px}\n.gate-logos .logo-ant{height:34px}\n@media (max-width:480px){.brand .logo-sep{display:none}.brand > div{flex-basis:100%}}\n.p-cancelado{background:var(--neutral-soft);color:var(--neutral);text-decoration:line-through}\n/* calendário */\n.cal-wrap{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:16px;align-items:start}\n@media (max-width:860px){.cal-wrap{grid-template-columns:1fr}}\n.cal-head{display:flex;align-items:center;gap:8px;margin-bottom:12px;flex-wrap:wrap}\n.cal-head h2{margin:0 auto 0 0;font-size:20px}\n.icon-btn{width:34px;height:34px;border-radius:50%;border:1px solid var(--line);background:var(--surface);font-size:18px;display:grid;place-items:center;cursor:pointer;color:var(--ink);padding:0}\n.icon-btn:hover{border-color:var(--accent)}\n.cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}\n.dow{font-size:11px;text-transform:uppercase;letter-spacing:.07em;font-weight:700;color:var(--muted);text-align:center;padding:4px 0}\n.day{min-height:88px;border:1px solid var(--line);border-radius:10px;padding:6px;display:flex;flex-direction:column;gap:3px;background:var(--surface);text-align:left;min-width:0;cursor:pointer;color:var(--ink);font:inherit}\n.day:hover{border-color:var(--accent)}\n.day.out{background:transparent;border-color:transparent;opacity:.45}\n.day.wknd{background:var(--surface-2)}\n.day .n{font-weight:700;font-size:13px;display:flex;justify-content:space-between;align-items:center;width:100%}\n.day.today .n > span{background:var(--accent);color:var(--accent-ink);border-radius:999px;padding:0 7px}\n.day.sel{border:2px solid var(--accent);padding:5px;background:var(--accent-soft)}\n.ev{display:block;font-size:11px;font-weight:700;border-radius:5px;padding:1px 5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}\n.ev.agendado{background:var(--info-soft);color:var(--info)}\n.ev.confirmado{background:var(--ok-soft);color:var(--ok)}\n.ev.realizado{background:var(--neutral-soft);color:var(--neutral)}\n.ev.faltou{background:var(--warn-soft);color:var(--warn)}\n.more{display:block;font-size:11px;color:var(--muted);font-weight:700}\n.alert-dot{width:8px;height:8px;border-radius:50%;background:var(--sun);display:block}\n.dots{display:none;gap:3px;flex-wrap:wrap;justify-content:center}\n.dots i{width:7px;height:7px;border-radius:50%;display:block}\n.d-agendado{background:var(--info)}.d-confirmado{background:var(--ok)}.d-realizado{background:var(--neutral)}.d-faltou{background:var(--warn)}\n@media (max-width:560px){.day{min-height:52px;padding:5px 3px;align-items:center}.day.sel{padding:4px 2px}.ev,.more{display:none}.dots{display:flex}.day .n{justify-content:center}.day .n .alert-dot{display:none}}\n.legend{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px;font-size:12px;color:var(--muted);font-weight:600}\n.legend span{display:flex;align-items:center;gap:5px}\n.legend i{width:10px;height:10px;border-radius:3px;display:block}\n.dia-head{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin-bottom:12px}\n.dia-head h2{margin:0}\n\n#live-painel{display:grid;gap:20px}\n.day .ev{width:100%;box-sizing:border-box}\n.day{align-items:stretch}\n.cal-wrap .item{grid-template-columns:1fr}\n.cal-wrap .item-time{grid-auto-flow:column;justify-content:start;align-items:baseline;gap:8px}\n\n.chips{display:flex;flex-wrap:wrap;gap:6px}\n.chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:999px;padding:6px 12px;font-size:14px;font-weight:600;cursor:pointer;background:var(--surface)}\n.chip:has(input:checked){border-color:var(--accent);background:var(--accent-soft);color:var(--accent)}\n.chip input{accent-color:var(--accent)}\n.ficha-overlay{position:fixed;inset:0;background:rgba(20,10,10,.45);z-index:30;overflow:auto;padding:calc(16px + env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) 24px max(16px,env(safe-area-inset-left,0px))}\n.ficha{max-width:760px;margin:0 auto;background:#fff;color:#1d1515;border-radius:14px;padding:28px;font-size:14px}\n.ficha-top{display:flex;align-items:center;gap:14px;border-bottom:2px solid #C8102E;padding-bottom:12px;margin-bottom:14px;flex-wrap:wrap}\n.ficha-top h2{font-size:20px;margin:0}.ficha-top p{margin:0;color:#6e6462}\n.ficha .logo-eus{width:56px;height:56px}.ficha .logo-ant{height:26px;width:auto}\n.ficha-tab{width:100%;border-collapse:collapse;margin-bottom:10px}\n.ficha-tab th{text-align:left;width:34%;padding:6px 8px;background:#f6f1f0;border:1px solid #e3d9d7;font-weight:700;vertical-align:top}\n.ficha-tab td{padding:6px 8px;border:1px solid #e3d9d7}\n.ficha h3{font-size:14px;margin:14px 0 6px;text-transform:uppercase;letter-spacing:.06em}\n.ficha-box{border:1px solid #e3d9d7;border-radius:8px;padding:10px;min-height:60px}\n.ficha-line{display:block;border-bottom:1px solid #bbb;height:22px}\n.ficha-ret{margin:14px 0}\n.ficha-ass{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:40px;text-align:center;font-size:12px}\n.ficha-ass span{display:block;border-top:1px solid #333;margin-bottom:4px}\n@media (max-width:560px){.ficha{padding:18px}.ficha-ass{grid-template-columns:1fr;gap:30px}}\n@media print{\n  body.ficha-aberta > *:not(.ficha-overlay){display:none!important}\n  .ficha-overlay{position:static;background:none;padding:0;overflow:visible}\n  .ficha{max-width:none;border-radius:0;padding:0}\n  .noprint{display:none!important}\n  :root{padding:0}\n}\n.top .tag{margin-left:auto}\n\n.seg-toggle{display:inline-flex;gap:4px;background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:4px;justify-self:start;flex-wrap:wrap}\n.seg-btn{border:0;background:none;border-radius:999px;padding:7px 14px;font-weight:700;color:var(--muted);cursor:pointer;font:inherit;font-weight:700}\n.seg-btn[aria-pressed=\"true\"]{background:var(--accent);color:var(--accent-ink)}\n.segtag{font-size:11px;font-weight:700;border-radius:6px;padding:1px 6px;letter-spacing:.04em}\n.segtag.s-EI{background:var(--accent-soft);color:var(--accent)}\n.segtag.s-EFAI{background:var(--info-soft);color:var(--info)}\n.segtag.s-EFAF{background:var(--sun-soft);color:var(--warn)}\n.segtag.s-EM{background:var(--ok-soft);color:var(--ok)}\n</style>\n</head>\n<body>\n<div id=\"app\"><div class=\"gate wrap\"><div class=\"gate-card\"><h1>Calendário de Atendimentos</h1><p class=\"muted\">Carregando…</p></div></div></div>\n<script type=\"module\" src=\"calendario.js\"></script>\n</body>\n</html>\n","calendario.js":"// Calendário compartilhado (somente leitura) — Atendimentos às Famílias (EI, EFAI, EFAF e EM)\nimport { initializeApp } from \"https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js\";\nimport { getFirestore, collection, onSnapshot } from \"https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js\";\nimport { firebaseConfig } from \"./firebase-config.js\";\nimport { LOGO_E, LOGO_A } from \"./logos.js\";\n\nconst STATUS_LBL = {agendado:'Agendado',confirmado:'Confirmado',realizado:'Realizado',faltou:'Família faltou',cancelado:'Cancelado'};\nconst MESES=['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];\nconst DIAS_LONGO=['domingo','segunda-feira','terça-feira','quarta-feira','quinta-feira','sexta-feira','sábado'];\nconst pad=n=>String(n).padStart(2,'0');\nconst iso=d=>d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());\nconst hoje=()=>iso(new Date());\nconst esc=v=>String(v==null?'':v).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction dataLonga(s){const d=new Date(s+'T12:00');const t=DIAS_LONGO[d.getDay()]+', '+pad(d.getDate())+'/'+pad(d.getMonth()+1);return t.charAt(0).toUpperCase()+t.slice(1)}\nfunction relDia(s){const h=new Date();const a=iso(h);h.setDate(h.getDate()+1);const b=iso(h);return s===a?'Hoje':s===b?'Amanhã':''}\n\nconst S={itens:[],ok:false,mes:hoje().slice(0,7),dia:hoje(),erro:'',segView:''};\nfunction seg(a){if(a.segmento)return a.segmento;const t=a.turma||'';if(/s[ée]rie/i.test(t)||/\\bEM\\b/.test(t))return 'Ensino Médio';if(/[6-9]\\s*º?\\s*ano/i.test(t))return 'EFAF';if(/ano/i.test(t))return 'EFAI';return 'Educação Infantil'}\nfunction segCurto(s){return s==='EFAI'||s==='EFAF'?s:s==='Ensino Médio'?'EM':'EI'}\nconst SEG_URL=window.SEG_FIXO||{EI:'Educação Infantil',EFAI:'EFAI',EFAF:'EFAF',EM:'Ensino Médio'}[(new URLSearchParams(location.search).get('seg')||'').toUpperCase()]||'';\nif(SEG_URL)S.segView=SEG_URL;\nconst vis=a=>!S.segView||seg(a)===S.segView;\nfunction segToggle(){if(SEG_URL)return '';return '<div class=\"seg-toggle\" role=\"group\" aria-label=\"Segmento\">'+[['','Todos'],['Educação Infantil','Educação Infantil'],['EFAI','EFAI'],['EFAF','EFAF'],['Ensino Médio','Ensino Médio']].map(o=>'<button type=\"button\" class=\"seg-btn\" data-seg=\"'+o[0]+'\" aria-pressed=\"'+(S.segView===o[0])+'\">'+o[1]+'</button>').join('')+'</div>'}\n\nconst app=document.getElementById('app');\n\nfunction render(){\n  const [y,m]=S.mes.split('-').map(Number);\n  const first=new Date(y,m-1,1);\n  const total=Math.ceil((first.getDay()+new Date(y,m,0).getDate())/7)*7;\n  const porDia={};S.itens.forEach(a=>{if(a.status!=='cancelado'&&vis(a))(porDia[a.data]=porDia[a.data]||[]).push(a)});\n  const h=hoje();let cells='';\n  for(let i=0;i<total;i++){\n    const d=new Date(y,m-1,1-first.getDay()+i),ds=iso(d),fora=d.getMonth()!==m-1,evs=porDia[ds]||[];\n    const cls='day'+(fora?' out':'')+(d.getDay()===0||d.getDay()===6?' wknd':'')+(ds===h?' today':'')+(ds===S.dia?' sel':'');\n    cells+='<button type=\"button\" class=\"'+cls+'\" data-dia=\"'+ds+'\" aria-pressed=\"'+(ds===S.dia)+'\" aria-label=\"'+esc(dataLonga(ds))+': '+evs.length+' atendimento(s)\">'+\n      '<span class=\"n\"><span>'+d.getDate()+'</span></span>'+\n      evs.slice(0,2).map(a=>'<span class=\"ev '+esc(a.status)+'\" title=\"'+esc(a.hora)+'\">'+esc(String(a.crianca).split(' ')[0])+'</span>').join('')+\n      (evs.length>2?'<span class=\"more\">+'+(evs.length-2)+' mais</span>':'')+\n      (evs.length?'<span class=\"dots\">'+evs.map(a=>'<i class=\"d-'+esc(a.status)+'\"></i>').join('')+'</span>':'')+'</button>';\n  }\n  const lista=S.itens.filter(a=>a.data===S.dia&&vis(a));\n  const rel=relDia(S.dia);\n  app.innerHTML=\n   '<header class=\"top\"><div class=\"wrap\"><div class=\"brand\"><img class=\"logo-eus\" src=\"'+LOGO_E+'\" alt=\"Antares Full Time Eusébio\"><img class=\"logo-ant\" src=\"'+LOGO_A+'\" alt=\"Colégio Antares\"><span class=\"logo-sep\"></span><div><h1>Calendário de Atendimentos</h1><small>'+(SEG_URL||'Educação Infantil, EFAI, EFAF e Ensino Médio')+'</small></div></div><span class=\"tag\">Somente leitura</span></div></header>'+\n   '<main class=\"wrap\"><div class=\"view\">'+\n   (S.erro?'<p class=\"msg err\">'+esc(S.erro)+'</p>':'')+\n   segToggle()+'<div class=\"cal-wrap\"><section class=\"panel\">'+\n    '<div class=\"cal-head\"><h2>'+MESES[m-1]+' '+y+'</h2><button class=\"btn small\" data-cal=\"0\">Hoje</button><button class=\"icon-btn\" data-cal=\"-1\" aria-label=\"Mês anterior\">‹</button><button class=\"icon-btn\" data-cal=\"1\" aria-label=\"Próximo mês\">›</button></div>'+\n    '<div class=\"cal\">'+['dom','seg','ter','qua','qui','sex','sáb'].map(x=>'<div class=\"dow\">'+x+'</div>').join('')+cells+'</div>'+\n    '<div class=\"legend\"><span><i class=\"d-agendado\"></i>Agendado</span><span><i class=\"d-confirmado\"></i>Confirmado</span><span><i class=\"d-realizado\"></i>Realizado</span><span><i class=\"d-faltou\"></i>Família faltou</span></div>'+\n   '</section><section class=\"panel\">'+\n    '<div class=\"dia-head\"><h2>'+esc(dataLonga(S.dia))+'</h2>'+(rel?'<span class=\"turma\">'+rel+'</span>':'')+'</div>'+\n    (!S.ok?'<p class=\"muted\">Carregando…</p>':lista.length?'<div class=\"list\">'+lista.map(a=>\n      '<article class=\"item st-'+esc(a.status)+'\"><div class=\"item-time\"><b>'+esc(a.hora)+'</b><span>'+(Number(a.duracao)||30)+' min</span></div><div style=\"min-width:0\">'+\n      '<div class=\"item-top\"><h3>'+esc(a.crianca)+'</h3><span class=\"turma\">'+esc(a.turma)+'</span><span class=\"segtag s-'+segCurto(seg(a))+'\">'+segCurto(seg(a))+'</span><span class=\"pill p-'+esc(a.status)+'\">'+esc(STATUS_LBL[a.status]||a.status)+'</span></div>'+\n      '<p class=\"item-sub muted\">'+esc(a.modalidade)+(a.atende?' · com '+esc(a.atende):'')+'</p></div></article>').join('')+'</div>'\n     :'<div class=\"empty\"><b>Nenhum atendimento neste dia.</b></div>')+\n   '</section></div>'+\n   '<p class=\"note\">Atualiza sozinho. Para agendar ou alterar, use o sistema de Atendimentos às Famílias.</p>'+\n   '</div></main>';\n}\ndocument.addEventListener('click',e=>{\n  const t=e.target.closest('[data-dia],[data-cal],[data-seg]');if(!t)return;\n  if(t.dataset.seg!==undefined){S.segView=t.dataset.seg;render();return}\n  if(t.dataset.dia){S.dia=t.dataset.dia;S.mes=S.dia.slice(0,7)}\n  else if(t.dataset.cal==='0'){S.mes=hoje().slice(0,7);S.dia=hoje()}\n  else{const p=S.mes.split('-').map(Number);S.mes=iso(new Date(p[0],p[1]-1+Number(t.dataset.cal),1)).slice(0,7)}\n  render();\n});\nrender();\ntry{\n  const db=getFirestore(initializeApp(firebaseConfig));\n  onSnapshot(collection(db,'publico'),snap=>{\n    S.itens=snap.docs.map(d=>Object.assign({id:d.id},d.data())).sort((a,b)=>String(a.quando).localeCompare(String(b.quando)));\n    S.ok=true;S.erro='';render();\n  },()=>{S.ok=true;S.erro='Não foi possível carregar o calendário agora. Tente recarregar a página.';render()});\n}catch(e){S.ok=true;S.erro='O calendário ainda não está configurado.';render()}\nsetInterval(render,60000);\n"}
